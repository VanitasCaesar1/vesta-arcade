{
  "name": "vesta-cli",
  "version": "0.1.0",
  "description": "Publish AI-made web games to your own Vesta arcade from the terminal or any MCP client. Free on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vesta": "dist/cli.js",
    "vesta-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "vesta.schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "games",
    "mcp",
    "claude-code",
    "cursor",
    "cloudflare",
    "vibe-coding",
    "itch.io",
    "html5"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanitasCaesar1/vesta-arcade.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/VanitasCaesar1/vesta-arcade#readme",
  "bugs": {
    "url": "https://github.com/VanitasCaesar1/vesta-arcade/issues"
  },
  "author": "Chakravarthi Chintapatla"
}
